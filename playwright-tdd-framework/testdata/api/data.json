            "description":"duplicate-repo",
            "private": true
        },
        "expStatusCode":422,
        "expStatusMessage":"Unprocessable Entity",
        "expErrorMessage":"name already exists on this account",
        "expErrorMsgType":"string"
    },   
     "validRepo":{
        "requestType":"post",
        "endpoint":"/user/repos",
        "payload":{
            "name":"playwright-repo-valid",
